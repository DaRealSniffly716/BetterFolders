<Window
    x:Class="BetterFolders.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BetterFolders"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="204"
    Height="290"
    AllowDrop="True"
    AllowsTransparency="True"
    Background="Transparent"
    DragOver="Window_DragOver"
    Drop="Window_Drop"
    Topmost="True"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <!--  Style Resources  -->

        <!--  App Style  -->
        <Style x:Key="AppStyle" TargetType="Border">
            <Setter Property="Background" Value="#77cccccc" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="0" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  App Text Style  -->
        <Style x:Key="AppTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Text" Value="Epic Games Launcher" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="24" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="WrapWithOverflow" />
        </Style>
    </Window.Resources>

    <!--  Main Grid  -->
    <Grid>
        <Border
            Padding="15"
            Background="#77777777"
            CornerRadius="20">
            <!--  App Grid  -->
            <Grid VerticalAlignment="Bottom">
                <!--  Define Rows  -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Define Columns  -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Define Grid Content  -->
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    Orientation="Vertical">
                    <Border x:Name="App1" Style="{StaticResource AppStyle}" />
                    <TextBlock x:Name="App1Text" Style="{StaticResource AppTextStyle}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="1"
                    Orientation="Vertical">
                    <Border x:Name="App2" Style="{StaticResource AppStyle}" />
                    <TextBlock x:Name="App2Text" Style="{StaticResource AppTextStyle}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="2"
                    Orientation="Vertical">
                    <Border x:Name="App3" Style="{StaticResource AppStyle}" />
                    <TextBlock x:Name="App3Text" Style="{StaticResource AppTextStyle}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="0"
                    Orientation="Vertical">
                    <Border x:Name="App4" Style="{StaticResource AppStyle}">
                        <Border.RenderTransform>
                            <TranslateTransform X="{Binding Path=RenderTransform.(TranslateTransform.X), ElementName=App1}" />
                        </Border.RenderTransform>
                    </Border>
                    <TextBlock x:Name="App4Text" Style="{StaticResource AppTextStyle}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    Orientation="Vertical">
                    <Border x:Name="App5" Style="{StaticResource AppStyle}">
                        <Border.RenderTransform>
                            <TranslateTransform X="{Binding Path=RenderTransform.(TranslateTransform.X), ElementName=App1}" />
                        </Border.RenderTransform>
                    </Border>
                    <TextBlock x:Name="App5Text" Style="{StaticResource AppTextStyle}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="2"
                    Orientation="Vertical">
                    <Border x:Name="App6" Style="{StaticResource AppStyle}">
                        <Border.RenderTransform>
                            <TranslateTransform X="{Binding Path=RenderTransform.(TranslateTransform.X), ElementName=App1}" />
                        </Border.RenderTransform>
                    </Border>
                    <TextBlock x:Name="App6Text" Style="{StaticResource AppTextStyle}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="2"
                    Grid.Column="0"
                    Orientation="Vertical">
                    <Border x:Name="App7" Style="{StaticResource AppStyle}">
                        <Border.RenderTransform>
                            <TranslateTransform X="{Binding Path=RenderTransform.(TranslateTransform.X), ElementName=App1}" />
                        </Border.RenderTransform>
                    </Border>
                    <TextBlock x:Name="App7Text" Style="{StaticResource AppTextStyle}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="2"
                    Grid.Column="1"
                    Orientation="Vertical">
                    <Border x:Name="App8" Style="{StaticResource AppStyle}">
                        <Border.RenderTransform>
                            <TranslateTransform X="{Binding Path=RenderTransform.(TranslateTransform.X), ElementName=App1}" />
                        </Border.RenderTransform>
                    </Border>
                    <TextBlock x:Name="App8Text" Style="{StaticResource AppTextStyle}" />
                </StackPanel>
                <StackPanel
                    Grid.Row="2"
                    Grid.Column="2"
                    Orientation="Vertical">
                    <Border x:Name="App9" Style="{StaticResource AppStyle}">
                        <Border.RenderTransform>
                            <TranslateTransform X="{Binding Path=RenderTransform.(TranslateTransform.X), ElementName=App1}" />
                        </Border.RenderTransform>
                    </Border>
                    <TextBlock x:Name="App9Text" Style="{StaticResource AppTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Search Box  -->
        <TextBox
            Margin="21,1,21,1"
            VerticalAlignment="Top"
            Background="#99000000"
            FontSize="12"
            Foreground="White"
            Text="Goober!" />

        <!--  Right Arrow  -->
        <Button
            Width="16"
            Height="36"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
            <Button.Template>
                <ControlTemplate>
                    <Canvas>
                        <!--  Edge Clip for Button  -->
                        <Canvas.Clip>
                            <RectangleGeometry Rect="0,0,16,36" />
                        </Canvas.Clip>

                        <!--  Button Background  -->
                        <Border
                            Width="16"
                            Height="36"
                            HorizontalAlignment="Right"
                            Background="#77cccccc"
                            BorderBrush="#77cccccc"
                            BorderThickness="1"
                            CornerRadius="5,0,0,5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ArrowHolder" X="12" />
                            </Border.RenderTransform>
                        </Border>

                        <!--  Arrow Path  -->
                        <Path
                            Margin="2,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Data="M3,4 L7,4 L11,18 L7,32 L3,32 L7,18 Z"
                            Fill="#77cccccc"
                            RenderTransform="{Binding ElementName=ArrowHolder}" />

                        <!--  Button Hitbox  -->
                        <Rectangle
                            Width="16"
                            Height="36"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Fill="Transparent" />

                        <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Canvas>
                    <!--  Animation and Triggers  -->
                    <ControlTemplate.Triggers>
                        <!--  Hover Trigger  -->
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <!--  Button Animation  -->
                                    <DoubleAnimation
                                        Storyboard.TargetName="ArrowHolder"
                                        Storyboard.TargetProperty="X"
                                        To="0"
                                        Duration="0:0:0.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <!--  Leave Trigger  -->
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <!--  Button Animation  -->
                                    <DoubleAnimation
                                        Storyboard.TargetName="ArrowHolder"
                                        Storyboard.TargetProperty="X"
                                        To="12"
                                        Duration="0:0:0.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>

            <!--  Button Action  -->
            <Button.Triggers>
                <EventTrigger RoutedEvent="Button.Click">
                    <BeginStoryboard>
                        <Storyboard>
                            <!--  Slide Animation for App Grid  -->
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="App1" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)">
                                <!--  Slide to the side  -->
                                <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="-80" />
                                <!--  Jump to the other side  -->
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.201" Value="188" />
                                <!--  Slide back to the original position  -->
                                <LinearDoubleKeyFrame KeyTime="0:0:0.67" Value="0" />
                            </DoubleAnimationUsingKeyFrames>

                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="App2" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)">
                                <!--  Slide to the side  -->
                                <LinearDoubleKeyFrame KeyTime="0:0:0.335" Value="-134" />
                                <!--  Jump to the other side  -->
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.336" Value="134" />
                                <!--  Slide back to the original position  -->
                                <LinearDoubleKeyFrame KeyTime="0:0:0.67" Value="0" />
                            </DoubleAnimationUsingKeyFrames>

                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="App3" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)">
                                <!--  Slide to the side  -->
                                <LinearDoubleKeyFrame KeyTime="0:0:0.47" Value="-188" />
                                <!--  Jump to the other side  -->
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.471" Value="80" />
                                <!--  Slide back to the original position  -->
                                <LinearDoubleKeyFrame KeyTime="0:0:0.67" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Button.Triggers>
        </Button>

        <!--  Left Arrow  -->
        <Button
            Width="16"
            Height="36"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
            <Button.Template>
                <ControlTemplate>
                    <!--  Button Visuals  -->
                    <Canvas>

                        <!--  Edge Clip for Button  -->
                        <Canvas.Clip>
                            <RectangleGeometry Rect="0,0,16,36" />
                        </Canvas.Clip>

                        <!--  Button Background  -->
                        <Border
                            Width="16"
                            Height="36"
                            HorizontalAlignment="Left"
                            Background="#77cccccc"
                            BorderBrush="#77cccccc"
                            BorderThickness="1"
                            CornerRadius="0,5,5,0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ArrowHolder" X="-12" />
                            </Border.RenderTransform>
                        </Border>

                        <!--  Arrow Path  -->
                        <Path
                            Margin="-2,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Data="M13,4 L9,4 L5,18 L9,32 L13,32 L9,18 Z"
                            Fill="#77cccccc"
                            RenderTransform="{Binding ElementName=ArrowHolder}" />

                        <!--  Button Hitbox  -->
                        <Rectangle
                            Width="16"
                            Height="36"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Fill="Transparent" />

                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Canvas>
                    <!--  Animation and Triggers  -->
                    <ControlTemplate.Triggers>
                        <!--  Hover Trigger  -->
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <!--  Button Animation  -->
                                    <DoubleAnimation
                                        Storyboard.TargetName="ArrowHolder"
                                        Storyboard.TargetProperty="X"
                                        To="0"
                                        Duration="0:0:0.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <!--  Leave Trigger  -->
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <!--  Button Animation  -->
                                    <DoubleAnimation
                                        Storyboard.TargetName="ArrowHolder"
                                        Storyboard.TargetProperty="X"
                                        To="-12"
                                        Duration="0:0:0.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>

            <!--  Button Action  -->
            <Button.Triggers>
                <EventTrigger RoutedEvent="Button.Click">
                    <BeginStoryboard>
                        <Storyboard>
                            <!--  Slide Animation for App Grid  -->
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="App1" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)">
                                <!--  Slide to the side  -->
                                <LinearDoubleKeyFrame KeyTime="0:0:0.47" Value="188" />
                                <!--  Jump to the other side  -->
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.471" Value="-80" />
                                <!--  Slide back to the original position  -->
                                <LinearDoubleKeyFrame KeyTime="0:0:0.67" Value="0" />
                            </DoubleAnimationUsingKeyFrames>

                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="App2" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)">
                                <!--  Slide to the side  -->
                                <LinearDoubleKeyFrame KeyTime="0:0:0.335" Value="134" />
                                <!--  Jump to the other side  -->
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.336" Value="-134" />
                                <!--  Slide back to the original position  -->
                                <LinearDoubleKeyFrame KeyTime="0:0:0.67" Value="0" />
                            </DoubleAnimationUsingKeyFrames>

                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="App3" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)">
                                <!--  Slide to the side  -->
                                <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="80" />
                                <!--  Jump to the other side  -->
                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.201" Value="-188" />
                                <!--  Slide back to the original position  -->
                                <LinearDoubleKeyFrame KeyTime="0:0:0.67" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Button.Triggers>
        </Button>
    </Grid>
    <!--  End of Main Grid  -->
</Window>
