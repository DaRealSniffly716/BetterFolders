<Window
    x:Class="BetterFolders.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BetterFolders"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="204"
    Height="218"
    AllowsTransparency="True"
    Background="Transparent"
    Topmost="True"
    WindowStyle="None"
    mc:Ignorable="d">
    <Grid>
        <Border
            Padding="15"
            Background="#77777777"
            CornerRadius="20">
            <Grid VerticalAlignment="Bottom">
                <!--  Define Rows  -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Define Columns  -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Define Grid Content  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="5"
                    Padding="24"
                    Background="#77cccccc"
                    CornerRadius="5" />
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5"
                    Padding="24"
                    Background="#77cccccc"
                    CornerRadius="5" />
                <Border
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="5"
                    Padding="24"
                    Background="#77cccccc"
                    CornerRadius="5" />
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="5"
                    Padding="24"
                    Background="#77cccccc"
                    CornerRadius="5" />
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="5"
                    Padding="24"
                    Background="#77cccccc"
                    CornerRadius="5" />
                <Border
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="5"
                    Padding="24"
                    Background="#77cccccc"
                    CornerRadius="5" />
                <Border
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="5"
                    Padding="24"
                    Background="#77cccccc"
                    CornerRadius="5" />
                <Border
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="5"
                    Padding="24"
                    Background="#77cccccc"
                    CornerRadius="5" />
                <Border
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin="5"
                    Padding="24"
                    Background="#77cccccc"
                    CornerRadius="5" />
            </Grid>
        </Border>

        <!--  Search Box  -->
        <Border Margin="21,1,21,1" VerticalAlignment="Top">
            <TextBox
                Background="#99000000"
                FontSize="12"
                Foreground="White"
                Text="Goober!" />
        </Border>

        <!--  Right Arrow  -->
        <Button
            Width="16"
            Height="36"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
            <Button.Template>
                <ControlTemplate>
                    <Canvas>
                        <!--  Edge Clip for Button  -->
                        <Canvas.Clip>
                            <RectangleGeometry Rect="0,0,16,36" />
                        </Canvas.Clip>

                        <Border
                            Width="16"
                            Height="36"
                            HorizontalAlignment="Right"
                            Background="#77cccccc"
                            BorderBrush="#77cccccc"
                            BorderThickness="1"
                            CornerRadius="5,0,0,5" />
                        <!--  Arrow Path  -->
                        <Path
                            Margin="2,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Data="M3,4 L7,4 L11,18 L7,32 L3,32 L7,18 Z"
                            Fill="#77cccccc" />
                        <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Canvas>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!--  Left Arrow  -->
        <Button
            Width="16"
            Height="36"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
            <Button.Template>
                <ControlTemplate>
                    <!--  Button Visuals  -->
                    <Canvas>
                        <!--  Button RenderTransform  -->
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="ArrowTranslateTransform" X="-12" />
                        </Canvas.RenderTransform>

                        <!--  Edge Clip for Button  -->
                        <Canvas.Clip>
                            <RectangleGeometry Rect="0,0,16,36" />
                        </Canvas.Clip>

                        <Border
                            Width="16"
                            Height="36"
                            HorizontalAlignment="Left"
                            Background="#77cccccc"
                            BorderBrush="#77cccccc"
                            BorderThickness="1"
                            CornerRadius="0,5,5,0" />
                        <!--  Arrow Path  -->
                        <Path
                            Margin="-2,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Data="M13,4 L9,4 L5,18 L9,32 L13,32 L9,18 Z"
                            Fill="#77cccccc" />
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Canvas>

                    <!--  Animation and Triggers  -->
                    <ControlTemplate.Triggers>
                        <!--  Hover Trigger  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <!--  Hover Action  -->
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!--  Button Animation  -->
                                        <DoubleAnimation
                                            Storyboard.TargetName="ArrowTranslateTransform"
                                            Storyboard.TargetProperty="X"
                                            From="-12"
                                            To="0"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>

                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ArrowTranslateTransform"
                                            Storyboard.TargetProperty="X"
                                            From="0"
                                            To="-12"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
    <!--  End of Main Grid  -->
</Window>
